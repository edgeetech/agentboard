{
  "name": "agentboard-workspace",
  "private": true,
  "type": "module",
  "description": "AgentBoard monorepo workspace during architecture refactor.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server",
    "plugins/providers/*",
    "plugins/hosts/*"
  ],
  "scripts": {
    "check": "npm --prefix plugins/claude-code/agent-board-core run check",
    "build": "npm --prefix plugins/claude-code/agent-board-core run build",
    "lint": "npm --prefix plugins/claude-code/agent-board-core run lint",
    "typecheck": "npm --prefix plugins/claude-code/agent-board-core run typecheck && npm run typecheck:engine && npm run typecheck:contracts",
    "typecheck:engine": "node plugins/claude-code/agent-board-core/node_modules/typescript/bin/tsc --noEmit -p packages/engine/tsconfig.json --pretty false",
    "typecheck:contracts": "node plugins/claude-code/agent-board-core/node_modules/typescript/bin/tsc --noEmit -p packages/contracts/tsconfig.json --pretty false",
    "test": "npm --prefix plugins/claude-code/agent-board-core run test && npm run test:engine",
    "test:unit": "npm run test",
    "test:engine": "node plugins/claude-code/agent-board-core/node_modules/vitest/vitest.mjs run packages/engine/test",
    "test:integration": "npm --prefix plugins/claude-code/agent-board-core run test",
    "test:e2e": "echo \"Playwright suite not introduced yet\"",
    "test:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
