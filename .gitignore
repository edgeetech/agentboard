# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output — UI dist IS committed (shipped with plugin; see note below).
# core/ui/dist/  # keep committed; zero-install distribution
# Server-side TS runs via Node 22 strip-types directly; no JS emit needed.
apps/ui/dist/
core/dist/
core/**/*.d.ts.map
core/**/*.js.map
core/server.js
core/server.d.ts
core/check-runs.js
core/check-runs.d.ts
core/bin/*.js
core/bin/*.d.ts
core/src/**/*.js
core/src/**/*.d.ts
!core/src/vite-env.d.ts
!apps/ui/src/vite-env.d.ts
!core/ui/dist/**/*.js

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
Desktop.ini
$RECYCLE.BIN/

# Logs / tmp
*.log
*.pid
*.seed
.cache/
tmp/
.tmp/

# TypeScript / bundler caches
*.tsbuildinfo
.vite/

# Coverage / test
coverage/
.nyc_output/
playwright-report/
test-results/

# Env / secrets (never commit)
.env
.env.*
!.env.example

# Local Node modules cache from failed installs
.node_modules_cache/
